{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rmuraix/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update sheldon github plugins pinned by tag",
      "managerFilePatterns": [
        "/(^|/)\\.config/sheldon/plugins\\.toml$/"
      ],
      "matchStrings": [
        "github\\s*=\\s*\"(?<depName>[^\"]+)\"\\s*\\ntag\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update sheldon github plugins pinned by commit rev",
      "managerFilePatterns": [
        "/(^|/)\\.config/sheldon/plugins\\.toml$/"
      ],
      "matchStrings": [
        "github\\s*=\\s*\"(?<depName>[^\"]+)\"\\s*\\nrev\\s*=\\s*\"(?<currentDigest>[^\"]+)\"[^\\n]*#\\s*renovate:\\s*branch=(?<currentValue>\\S+)"
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "datasourceTemplate": "git-refs"
    }
  ]
}
